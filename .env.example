# Copia este archivo a .env y rellena los valores.

# OpenAI (generación de respuestas)
OPENAI_API_KEY=

# Serper.dev (búsqueda en Google)
SERPERDEV_API_KEY=

# WeatherAPI.com (clima y alertas)
WEATHER_API=

# Supabase (historial de conversaciones)
SUPABASE_URL=
SUPABASE_KEY=

# Ruta al TXT de empresas Agrotech (opcional; por defecto data/empresas_agrotech.txt)
AGROTECH_DATA_PATH=
